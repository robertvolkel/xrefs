{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-docs-on-push.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking docs gate…"
          }
        ]
      }
    ]
  }
}
